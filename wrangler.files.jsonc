{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wdpr-render-files-dev",
	"main": "src/files/index.ts",
	"compatibility_date": "2026-09-04",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true,
	},
	"secrets": {
		"required": ["FILES_URL_SECRET"],
	},
	"r2_buckets": [
		{
			"binding": "HTML_BLOCKS",
			"bucket_name": "wdpr-render-html-dev",
		},
	],
	"observability": {
		"enabled": true,
		"redact_query_string": true,
	},
	"upload_source_maps": true,
	"env": {
		"staging": {
			"name": "wdpr-render-files-staging",
			"secrets": {
				"required": ["FILES_URL_SECRET"],
			},
			"r2_buckets": [
				{
					"binding": "HTML_BLOCKS",
					"bucket_name": "wdpr-render-html-staging",
				},
			],
		},
		"production": {
			"name": "wdpr-render-files-prd",
			"secrets": {
				"required": ["FILES_URL_SECRET"],
			},
			"r2_buckets": [
				{
					"binding": "HTML_BLOCKS",
					"bucket_name": "wdpr-render-html-prd",
				},
			],
		},
	},
}
