{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wdpr-render-files-dev",
	"main": "src/files/index.ts",
	"compatibility_date": "2026-09-04",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true,
	},
	"r2_buckets": [
		{
			"binding": "HTML_BLOCKS",
			"bucket_name": "wdpr-render-html-dev",
		},
	],
	"observability": {
		"enabled": true,
	},
	"upload_source_maps": true,
}
