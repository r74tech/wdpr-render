{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"allowJs": true,
		"noEmit": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"./worker-configuration.d.ts",
			"@cloudflare/vitest-plugin/types",
			"@types/bun",
			"node"
		],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"worker-configuration.d.ts",
		"files-worker-configuration.d.ts",
		"src/**/*.ts",
		"test/**/*.ts",
		"scripts/**/*.ts",
		"vitest.config.ts",
		"vitest.files.config.ts"
	]
}
